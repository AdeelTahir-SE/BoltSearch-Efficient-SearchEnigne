# Copy this file to server/.env. Secrets stay on the server; never use VITE_* keys.
# Answer generation: choose fireworks, xai (Grok), or custom.
RAG_PROVIDER=fireworks
FIREWORKS_API_KEY=
XAI_API_KEY=
# Required: use a chat model ID available in your provider account.
RAG_MODEL=
# Optional overrides, especially for another OpenAI-compatible host:
BASE_URL=https://api.fireworks.ai/inference/v1
# RAG_BASE_URL, when set, overrides BASE_URL.
RAG_BASE_URL=
RAG_API_KEY=

# Embeddings are independent of the answer provider.
EMBEDDING_PROVIDER=openai
# Local Ollama alternative (no embedding key required):
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=nomic-embed-text:latest
# OLLAMA_EMBEDDING_THREADS=2
# Fireworks example: https://api.fireworks.ai/inference/v1
EMBEDDING_BASE_URL=https://api.fireworks.ai/inference/v1
# Falls back to FIREWORKS_API_KEY. Grok chat keys are NOT assumed to support embeddings.
EMBEDDING_API_KEY=
# Required: an embedding model ID available in your account (not a chat model).
EMBEDDING_MODEL=
# Set prefixes according to your embedding model's documentation, e.g. for Nomic:
# EMBEDDING_QUERY_PREFIX="search_query: "
# EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
# Bump if the provider changes weights behind the same embedding model ID.
EMBEDDING_VERSION=1
# Cosine floor for semantic candidates. Tune against your model and evaluation set.
RAG_MIN_SIMILARITY=0.25

# Optional. Defaults to server/dataset/rag.sqlite3.
# RAG_DB_PATH=D:/data/bolt-rag.sqlite3
# PYTHON=python
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Offline Ragas judge overrides. Defaults to the configured Fireworks answer model/key.
# Prefer a separate judge model for independent assessment.
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_KEY=
